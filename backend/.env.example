# ==========================================
# NusaBridge - Environment Template
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env asli ke Git.
# ==========================================

# Port server backend
PORT=5000

# Google Groq API Key (opsional)
# Jika kosong, backend otomatis memakai Smart Heuristic Trade Engine.
# Ambil key di: https://console.groq.com/keys
GROQ_API_KEY=YOUR_API_KEY_HERE

# ==========================================
# SUPABASE (DATABASE)
# Buka: Project Settings -> API
# ==========================================
# Project URL (contoh: https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=https://PROJECT-REF.supabase.co

# service_role key = RAHASIA. Hanya untuk backend, JANGAN taruh di frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
