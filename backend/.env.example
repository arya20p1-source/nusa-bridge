# ==========================================
# NusaBridge - Environment Template
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env asli ke Git.
# ==========================================

# Port server backend
PORT=5000

# Rahasia penandatanganan token sesi (HMAC-SHA256).
# WAJIB diisi di produksi dengan string acak panjang, contoh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=GANTI_DENGAN_RAHASIA_ACAK_PANJANG

# Password admin demo untuk database memori (hanya dipakai saat
# NUSABRIDGE_DB=memory). Untuk Supabase gunakan: npm run admin:create
DEMO_ADMIN_PASSWORD=Admin#2026

# Google Groq API Key (opsional)
# Jika kosong, backend otomatis memakai Smart Heuristic Trade Engine.
# Ambil key di: https://console.groq.com/keys
GROQ_API_KEY=YOUR_API_KEY_HERE

# ==========================================
# SUPABASE (DATABASE)
# Buka: Project Settings -> API
# ==========================================
# Project URL (contoh: https://abcdefghijklmnop.supabase.co)
SUPABASE_URL=https://PROJECT-REF.supabase.co

# service_role key = RAHASIA. Hanya untuk backend, JANGAN taruh di frontend.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE
